# Copy to .env.local and fill in. .env.local is git-ignored.

# The Express backend. The /api/* rewrite in next.config.ts points here.
BACKEND_URL=http://localhost:4000

# The OAuth client ID from Google Cloud Console. Same value as the backend's
# GOOGLE_CLIENT_ID. It is public: the browser needs it to show the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
