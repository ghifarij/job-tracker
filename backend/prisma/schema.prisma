generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  APPLIED
  INTERVIEWED
  REJECTED
  GHOSTED
}

model User {
  id           String        @id @default(uuid())
  // Google's stable account ID (the `sub` claim). The email can change; this can't.
  googleId     String        @unique
  email        String
  name         String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  role      String
  link      String?
  // No defaults on status and appliedAt: src/newApplication.ts decides them.
  status    ApplicationStatus
  appliedAt DateTime          @db.Date
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Every list query filters by user, and often by status too.
  @@index([userId, status])
}
